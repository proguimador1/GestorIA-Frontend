# URL da API de autenticação (Django/djoser)
VITE_API_URL=http://localhost:8000
# true: usa contas locais de demonstração, sem backend. Use false quando a API estiver no ar.
VITE_MOCK_AUTH=false
# URL da API de autenticação (Django/djoser)
VITE_API_URL=http://localhost:8000
# true: usa contas locais de demonstração, sem backend. Use false quando a API estiver no ar.
VITE_MOCK_AUTH=false
# true (padrão): o app usa a data atual do computador como "hoje". false: usa o último dia da base de notas.
VITE_DATA_REAL=true

# Chatbot com Gemini: NÃO coloque a chave aqui. Crie o arquivo .env.local (na mesma pasta) com:
# GEMINI_API_KEY=sua_chave_aqui
# GEMINI_MODEL=gemini-3.8-flash   (opcional)
